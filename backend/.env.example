# Copy to .env and adjust. Real environment variables override this file.
APP_ENV=development
LOG_LEVEL=DEBUG
# JSON list of allowed browser origins
CORS_ORIGIN=["http://localhost:5173"]

# Review provider: mock (no AI, regex rules) | litellm (phase 3)
LLM_PROVIDER=mock

# POST /lint limits; larger snippets get 413
MAX_CODE_BYTES=20000
MAX_CODE_LINES=500
