# Copy to .env and adjust. Real environment variables override this file.
APP_ENV=development
LOG_LEVEL=DEBUG
# JSON list of allowed browser origins
CORS_ORIGIN=["http://localhost:5173"]

# Review provider: mock (no AI, regex rules) | litellm (real models through LiteLLM)
LLM_PROVIDER=mock

# POST /lint limits; larger snippets get 413
MAX_CODE_BYTES=20000
MAX_CODE_LINES=500

# LiteLLM (put your real key in .env, never here)
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Review cache: memory (default, lost on restart) | redis (shared, survives restarts)
CACHE_BACKEND=memory
CACHE_TTL_S=86400
REDIS_URL=redis://localhost:6379/0
